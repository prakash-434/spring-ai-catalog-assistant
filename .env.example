# Variable names only. Set real values in your shell or the service environment; never commit them.
CHATBOT_DB_URL=
CHATBOT_DB_USER=
CHATBOT_DB_PASSWORD=
# Gemini Developer API key (Google AI Studio). Never logged or committed.
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash.
CHATBOT_MODEL=
# Shared secret the website's server sends in X-Internal-Token.
CHATBOT_INTERNAL_TOKEN=
# Optional limits (defaults in application.yml).
CHATBOT_RATE_LIMIT_PER_MINUTE=
CHATBOT_RATE_LIMIT_PER_DAY=
CHATBOT_DAILY_TOKEN_BUDGET=
CHATBOT_INPUT_PRICE_PER_MILLION=
CHATBOT_OUTPUT_PRICE_PER_MILLION=
